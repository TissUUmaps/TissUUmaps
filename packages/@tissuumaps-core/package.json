{
  "name": "@tissuumaps/core",
  "version": "0.1.0-beta.0",
  "description": "Core model, types and utilities shared by the TissUUmaps packages",
  "homepage": "https://tissuumaps.github.io/TissUUmaps/",
  "bugs": "https://github.com/TissUUmaps/TissUUmaps/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TissUUmaps/TissUUmaps.git",
    "directory": "packages/@tissuumaps-core"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "./dist",
    "./CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "tissuumaps-development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b tsconfig.src.json && vite build",
    "clean": "rm -rf build dist node_modules",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "d3-color": "^3.1.0",
    "d3-scale-chromatic": "^3.1.0",
    "gl-matrix": "^3.4.4"
  },
  "devDependencies": {
    "@jsonforms/core": "^3.8.0",
    "@types/d3-color": "^3.1.3",
    "@types/d3-scale-chromatic": "^3.1.0",
    "openseadragon": "^6.1.1",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "@jsonforms/core": "^3.8.0",
    "openseadragon": "^6.1.1",
    "zustand": "^5.0.15"
  },
  "peerDependenciesMeta": {
    "@jsonforms/core": {
      "optional": true
    },
    "openseadragon": {
      "optional": true
    },
    "zustand": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  }
}
