{
  "name": "@tissuumaps/viewer",
  "version": "0.1.0",
  "description": "React viewer component for TissUUmaps",
  "homepage": "https://tissuumaps.github.io/TissUUmaps4/",
  "bugs": "https://github.com/TissUUmaps/TissUUmaps4/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TissUUmaps/TissUUmaps4.git",
    "directory": "packages/@tissuumaps-viewer"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "./dist"
  ],
  "exports": {
    ".": {
      "tissuumaps-development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.src.json && vite build",
    "prepack": "pnpm --filter \"{.}...\" run build",
    "clean": "rm -rf build dist node_modules",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@tissuumaps/core": "workspace:^",
    "@tissuumaps/render": "workspace:^",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "peerDependencies": {
    "@tissuumaps/core": "workspace:^",
    "@tissuumaps/render": "workspace:^",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.22.1"
  }
}
