{
  "name": "@tissuumaps/plugins",
  "version": "0.1.0-beta.1",
  "description": "Official plugin distribution for TissUUmaps",
  "homepage": "https://tissuumaps.github.io/",
  "bugs": "https://github.com/TissUUmaps/TissUUmaps/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TissUUmaps/TissUUmaps.git",
    "directory": "packages/@tissuumaps-plugins"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "./dist",
    "./CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "tissuumaps-development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ai-chat": {
      "tissuumaps-development": "./src/ai-chat/index.ts",
      "types": "./dist/ai-chat.d.ts",
      "default": "./dist/ai-chat.js"
    },
    "./spatialdata": {
      "tissuumaps-development": "./src/spatialdata/index.ts",
      "types": "./dist/spatialdata.d.ts",
      "default": "./dist/spatialdata.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b tsconfig.src.json && vite build",
    "clean": "rm -rf build dist node_modules",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@tissuumaps/core": "workspace:^",
    "immer": "^11.1.8",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "@tissuumaps/core": "workspace:^"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./ai-chat": {
        "types": "./dist/ai-chat.d.ts",
        "default": "./dist/ai-chat.js"
      },
      "./spatialdata": {
        "types": "./dist/spatialdata.d.ts",
        "default": "./dist/spatialdata.js"
      },
      "./package.json": "./package.json"
    }
  }
}
