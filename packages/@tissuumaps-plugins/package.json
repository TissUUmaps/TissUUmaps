{
  "name": "@tissuumaps/plugins",
  "version": "0.1.0",
  "description": "Official plugin distribution for TissUUmaps",
  "homepage": "https://tissuumaps.github.io/TissUUmaps4/",
  "bugs": "https://github.com/TissUUmaps/TissUUmaps4/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TissUUmaps/TissUUmaps4.git",
    "directory": "packages/@tissuumaps-plugins"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "./dist"
  ],
  "exports": {
    ".": {
      "tissuumaps-development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./spatialdata": {
      "tissuumaps-development": "./src/spatialdata/index.ts",
      "types": "./dist/spatialdata.d.ts",
      "import": "./dist/spatialdata.js",
      "default": "./dist/spatialdata.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.src.json && vite build",
    "prepack": "pnpm --filter \"{.}...\" run build",
    "clean": "rm -rf build dist node_modules",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@tissuumaps/core": "workspace:^"
  },
  "peerDependencies": {
    "@tissuumaps/core": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.22.1"
  }
}
