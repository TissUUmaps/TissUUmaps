      "default": "./dist/hdf5.js"
    },
    "./ome-zarr": {
      "tissuumaps-development": "./src/ome-zarr/index.ts",
      "types": "./dist/ome-zarr.d.ts",
      "import": "./dist/ome-zarr.js",
      "default": "./dist/ome-zarr.js"
    },
    "./openseadragon": {
      "tissuumaps-development": "./src/openseadragon/index.ts",
