{
  // Used only by unplugin-dts (api-extractor) for the .d.ts rollup. api-extractor
  // pins TypeScript 5.9, which does not recognize ES2025; override target/lib to
  // ESNext here (harmless for declaration bundling) so the rollup step succeeds.
  "extends": "./tsconfig.src.json",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "outDir": "./build/dts"
  }
}
