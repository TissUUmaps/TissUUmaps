{
  "name": "@tissuumaps/root",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.58.9",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^24.19.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.4",
    "remark-cli": "^12.0.1",
    "remark-validate-links": "^13.1.0",
    "typedoc": "^0.28.20",
    "typedoc-docusaurus-theme": "^1.4.3",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "unplugin-dts": "^1.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:docs": "remark docs --frail --quiet --no-stdout --use remark-validate-links",
    "typecheck": "tsc -b && tsc -p tsconfig.node.json && tsc -p scripts/tsconfig.json",
    "fmt": "prettier --write --ignore-unknown .",
    "fmt:check": "prettier --check --ignore-unknown .",
    "test": "vitest run --passWithNoTests --coverage",
    "test:scripts": "node --test scripts/*.test.ts",
    "dev": "pnpm run --filter tissuumaps dev",
    "build": "pnpm run -r build",
    "build:packages": "pnpm run -r --filter \"./packages/*\" build",
    "build:apidocs": "typedoc",
    "changeset": "changeset",
    "release": "pnpm run build:packages && changeset publish",
    "clean": "pnpm run -r clean && rm -rf coverage node_modules"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": "eslint --fix",
    "**/*": "prettier --write --ignore-unknown"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.15.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  }
}
