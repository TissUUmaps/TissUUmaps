{
  "name": "@tissuumaps/root",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.58.9",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^22.20.4",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "canvas": "^3.2.3",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "unplugin-dts": "^1.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc -b && tsc -p tsconfig.node.json",
    "fmt": "prettier --write --ignore-unknown .",
    "fmt:check": "prettier --check --ignore-unknown .",
    "test": "vitest run --passWithNoTests --coverage",
    "dev": "pnpm run --filter tissuumaps dev",
    "docs": "pnpm run --filter docs start",
    "build": "pnpm run -r --filter !docs build",
    "build:docs": "pnpm run build:packages && pnpm run --filter docs build",
    "build:packages": "pnpm run -r --filter \"./packages/*\" build",
    "clean": "pnpm run -r clean && rm -rf coverage node_modules"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": "eslint --fix",
    "**/*": "prettier --write --ignore-unknown"
  },
  "engines": {
    "node": ">=22.22.1",
    "pnpm": ">=11.15.1"
  }
}
